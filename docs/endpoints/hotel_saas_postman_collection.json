            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Grand Nile Luxury Resort\",\n  \"slug\": \"grand-nile-luxury-resort\",\n  \"subdomain\": \"grand-nile\",\n  \"email\": \"gm@grandnile.com\",\n  \"phone\": \"+20227988000\",\n  \"address\": \"Corniche El Nile, Garden City\",\n  \"city\": \"Cairo\",\n  \"country\": \"EG\",\n  \"timezone\": \"Africa/Cairo\",\n  \"default_currency\": \"USD\",\n  \"default_language\": \"en\",\n  \"status\": \"active\",\n  \"is_active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tenants/hotels/{{hotelId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["tenants", "hotels", "{{hotelId}}", ""]
            }
